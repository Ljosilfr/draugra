#!/usr/bin/env bash
source "$(dirname $(realpath ${BASH_SOURCE[0]}))/common.sh"
source "${std_gum_settings}"

[[ "${1}" == "run" ]] && { "${_root}/draugra-run" & disown; exit; }

run_in_termn

msgs=('Add game to DB' 'Edit existing DB object' 'Run Winetricks')
action="$(gum choose "${msgs[0]}" "${msgs[1]}" "${msgs[2]}" || exit 1)"

case "${action}" in
	"${msgs[0]}") exec "${_root}/draugra-add" ;;
	"${msgs[1]}") exec "${_root}/draugra-edit" ;;
	"${msgs[2]}") exec "${_root}/draugra-winetricks" ${@} ;;
esac
