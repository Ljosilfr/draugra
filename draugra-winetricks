#!/usr/bin/env bash
source "$(dirname $(realpath ${BASH_SOURCE[0]}))/common.sh"

y_picker() { yazi --chooser-file=/dev/stdout "${1}"; }

gum confirm "Use default PROTON build BINARY? → $(basename "${proton}" )" || {
	gum confirm "Pick the PROTON build BINARY" --affirmative=Next --negative=Cancel || exit 1
	proton="$(y_picker "${proton_builds}")"
}

gum confirm "Pick the PROTON PREFIX" --affirmative=Next --negative=Cancel || exit 1
prefix="$(y_picker "${prefixes}")"

export WINE="${proton}"
export WINEPREFIX="${prefix}"

winetricks "${@}"
